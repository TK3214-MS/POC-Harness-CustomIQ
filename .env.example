# Industry IQ Platform Accelerator - environment variables (example)
#
# 1. Copy this file to `.env` and fill in real values for your own test tenant/subscription.
# 2. Never commit the real `.env` file (it is already in .gitignore).
# 3. All GUID/URL values below are placeholders (fake tenant, fake subscription, example.com).
# 4. For production, use Azure Key Vault or another managed secret store instead of `.env`.
#    See docs/security/ (Phase 5+) for details.

# --- Execution mode ---
IIQ_EXECUTION_MODE=local_preview   # local_preview | hybrid | full_saas
IIQ_DEFAULT_INDUSTRY_PACK=manufacturing

# --- Azure (test subscription, per docs/decisions/open-questions.md Q4) ---
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-iiq-demo
AZURE_LOCATION=japaneast

# --- Microsoft Entra ID (app registration used by MCP Backend / Live adapters) ---
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Copilot Studio ("GitHub Copilot harness") ---
# Product/field names not yet verified - see docs/decisions/product-verification.md
COPILOT_STUDIO_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000
COPILOT_STUDIO_AGENT_ID=TBD-VERIFY-AGAINST-CURRENT-MICROSOFT-DOCUMENTATION
# OAuth scope requested when testing Entra ID auth for this product (Phase 4).
# Leave as the placeholder until confirmed against current Microsoft docs -
# see docs/setup/live-adapters-configuration.md.
COPILOT_STUDIO_AUTH_SCOPE=TBD-VERIFY-AGAINST-CURRENT-MICROSOFT-DOCUMENTATION

# --- Work IQ ---
WORK_IQ_WORKSPACE_ID=TBD-VERIFY-AGAINST-CURRENT-MICROSOFT-DOCUMENTATION
WORK_IQ_AUTH_SCOPE=TBD-VERIFY-AGAINST-CURRENT-MICROSOFT-DOCUMENTATION

# --- Foundry IQ ---
FOUNDRY_IQ_PROJECT_ENDPOINT=https://example-foundry-project.example.com
FOUNDRY_IQ_KNOWLEDGE_BASE_ID=TBD-VERIFY-AGAINST-CURRENT-MICROSOFT-DOCUMENTATION
FOUNDRY_IQ_AUTH_SCOPE=TBD-VERIFY-AGAINST-CURRENT-MICROSOFT-DOCUMENTATION

# --- Fabric IQ ---
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FABRIC_ONTOLOGY_ID=TBD-VERIFY-AGAINST-CURRENT-MICROSOFT-DOCUMENTATION
FABRIC_IQ_AUTH_SCOPE=TBD-VERIFY-AGAINST-CURRENT-MICROSOFT-DOCUMENTATION

# --- MCP Backend (this repo's FastAPI service) ---
MCP_BACKEND_BASE_URL=http://localhost:8000
MCP_BACKEND_API_KEY=

# --- Observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
