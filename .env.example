# Industry IQ Platform Accelerator - environment variables (example)
#
# 1. Copy this file to `.env` and fill in real values for the MCP Backend deployment.
# 2. Never commit the real `.env` file (it is already in .gitignore).
# 3. All GUID/URL values below are placeholders (fake tenant, fake subscription, example.com).
# 4. For production, use Azure Key Vault or another managed secret store instead of `.env`.
#    See docs/security/ (Phase 5+) for details.

# --- Azure deployment ---
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-iiq-platform
AZURE_LOCATION=japaneast

# --- MCP Backend ---
MCP_BACKEND_BASE_URL=http://localhost:8000
MCP_BACKEND_API_KEY=
# Optional defense-in-depth allowlist (comma-separated tool names). Leave
# unset to allow every tool the selected Industry Pack declares.
MCP_BACKEND_ALLOWED_TOOLS=
# Real MCP protocol endpoint (/mcp) host allowlist, comma-separated (e.g. the
# real Container App FQDN once deployed). localhost/127.0.0.1/testserver are
# always allowed regardless of this setting - see mcp_backend/mcp_protocol_server.py.
MCP_BACKEND_ALLOWED_HOSTS=

# --- Observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
